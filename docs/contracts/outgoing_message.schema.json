{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sertkontrol.local/contracts/outgoing_message.schema.json",
  "title": "OutgoingMessage",
  "description": "C9: полезная нагрузка outbox.payload. Пишет certd (R3), отправитель outbox (R4) переводит её в вызов Bot API MAX. Формат внутренний и не повторяет MAX API намеренно: соответствие полям MAX — в libs/maxapi (этап 1–2), после сверки с официальной документацией.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "max_user_id", "text"],
  "properties": {
    "version": { "const": 1, "description": "Версия схемы; меняется только с записью в docs/changelog-contracts.md." },
    "max_user_id": { "type": "integer", "minimum": 1, "description": "Получатель — пользователь MAX." },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000, "description": "Текст сообщения; лимит MAX — 4000 символов (АРХ §8)." },
    "kind": {
      "enum": ["reply", "verdict", "status_changed", "service"],
      "default": "reply",
      "description": "Назначение сообщения — для метрик и приоритета."
    },
    "is_demo": { "type": "boolean", "default": false, "description": "Сообщение построено на тестовых данных: отправитель добавляет пометку." },
    "buttons": {
      "type": "array",
      "description": "Ряды кнопок. Особых кнопок (link, open_app) — не больше 3 в ряду (АРХ §8); проверяется кодом отправителя.",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/button" }
      }
    }
  },
  "$defs": {
    "button": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text", "payload"],
          "properties": {
            "type": { "const": "callback" },
            "text": { "type": "string", "minLength": 1 },
            "payload": {
              "type": "string",
              "pattern": "^[wsynd]:[0-9]+$",
              "description": "<действие>:<id записи в БД> (АРХ §8): w — на контроль, s — поставщик, y/n — подтверждение OCR, d — удалить."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text", "url"],
          "properties": {
            "type": { "const": "link" },
            "text": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "open_app" },
            "text": { "type": "string", "minLength": 1 },
            "start_param": { "type": "string", "description": "Параметр запуска мини-приложения (экран, документ)." }
          }
        }
      ]
    }
  }
}
