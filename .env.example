# Шаблон окружения. Скопируйте в .env и заполните. Рабочие значения в репозиторий НЕ коммитятся.
# Все переменные необязательны для локального запуска: без них стек поднимается на демо-данных.

# ── MAX (используются с этапа 1) ──
# Токен бота, выдаётся организаторами.
MAX_BOT_TOKEN=
# Секрет webhook: 5–256 символов A-Z a-z 0-9 _ -; MAX присылает его в заголовке X-Max-Bot-Api-Secret.
# Обязателен, если задан MAX_BOT_TOKEN.
MAX_WEBHOOK_SECRET=
# Публичное имя бота — для кнопок, открывающих мини-приложение (open_app). Пусто — кнопки не показываются.
MAX_BOT_USERNAME=
# Базовый адрес Bot API (по умолчанию https://platform-api2.max.ru).
MAX_API_BASE_URL=

# ── PostgreSQL ──
POSTGRES_DB=
POSTGRES_USER=
# Пусто — локальный режим trust внутри сети compose (ADR-0009). На VPS — обязательно задать.
POSTGRES_PASSWORD=
# trust (локально) или scram-sha-256 (VPS).
POSTGRES_HOST_AUTH_METHOD=

# ── certd ──
# Порт на хосте для certd (по умолчанию 8080).
CERTD_PUBLISH_PORT=
# Потоки IO Drogon (0 — по числу ядер) и соединения с БД.
CERTD_THREADS=
CERTD_DB_CONNECTIONS=
# Потоки и очередь распознавания PDF (по умолчанию 2 и 8).
CERTD_RECOG_THREADS=
CERTD_RECOG_QUEUE=
# Пользователь мини-приложения при открытии в браузере без MAX (по умолчанию 1000001).
# Игнорируется, если задан MAX_BOT_TOKEN (ADR-0013).
CERTD_DEV_USER_ID=

# ── Caddy (профиль prod) ──
# Домен для TLS-сертификата Let's Encrypt, например bot.example.ru.
SK_DOMAIN=
